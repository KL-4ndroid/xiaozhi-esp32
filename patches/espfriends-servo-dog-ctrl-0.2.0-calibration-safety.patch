@@ -23,6 +23,8 @@ static void servo_dog_ledc_stop(void);
 
 #define STEP_OFFSET                 5
+#define SERVO_MIN_ANGLE             0
+#define SERVO_MAX_ANGLE             180
 
 static uint16_t fl_angle_neutral = CONFIG_FL_ANGLE_NEUTRAL;
 static uint16_t fr_angle_neutral = CONFIG_FR_ANGLE_NEUTRAL;
@@ -92,10 +94,24 @@ void servo_dog_set_leg_offset(int8_t fl_offset, int8_t bl_offset, int8_t fr_off
     br_angle_neutral = CONFIG_BR_ANGLE_NEUTRAL + br_offset;
 }
 
-static void servo_set_angle(servo_id_t servo_id, uint16_t angle)
+static void servo_set_angle(servo_id_t servo_id, int angle)
 {
     if (g_servo_dog != NULL && g_servo_dog->servos[servo_id] != NULL) {
-        iot_servo_write_angle(g_servo_dog->servos[servo_id], angle);
+        int safe_angle = angle;
+        if (safe_angle < SERVO_MIN_ANGLE) {
+            safe_angle = SERVO_MIN_ANGLE;
+        } else if (safe_angle > SERVO_MAX_ANGLE) {
+            safe_angle = SERVO_MAX_ANGLE;
+        }
+
+        if (safe_angle != angle) {
+            ESP_LOGW(TAG, "Clamp servo %d angle from %d to %d", servo_id, angle, safe_angle);
+        }
+
+        esp_err_t ret = iot_servo_write_angle(g_servo_dog->servos[servo_id], safe_angle);
+        if (ret != ESP_OK) {
+            ESP_LOGE(TAG, "Failed to set servo %d angle to %d: %s", servo_id, safe_angle, esp_err_to_name(ret));
+        }
     }
 }
